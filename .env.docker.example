# ── PolyPanel — Docker Compose configuration ──────────────────────────────
# Copy to .env (never commit .env) and adjust. All values have safe defaults.
# Loaded by docker-compose.yml via `env_file: .env` so secrets stay out of git
# and out of the compose file.
#
# NOTE: DATA_DIR and PORT are pinned to container values in docker-compose.yml
# (DATA_DIR=/data, PORT=3000) and intentionally NOT set here — the named volume
# is mounted at /data and the host maps 127.0.0.1:3000. Don't override them here.

# ── Poller ────────────────────────────────────────────────────────────────
# Seconds between poll cycles. Conservative: 20–30s over ~50 markets is safe.
POLL_INTERVAL=25
# Number of top markets (by 24h volume) to track. Bounds request count.
MARKET_LIMIT=50
# Divergence threshold (absolute prob difference) that raises a DIVERGE flag.
DIVERGE_THRESHOLD=0.05
# Fee/slippage buffer applied to arbitrage detection (per share, in $).
ARB_FEE_BUFFER=0.01
# Spread (in $) on the primary outcome that raises a WIDE flag.
WIDE_SPREAD=0.05
# Max backoff (seconds) the poller waits after repeated errors / 429s.
MAX_BACKOFF=300
# Days of probability history to retain; older rows are pruned hourly.
HISTORY_RETENTION_DAYS=14

# ── Auth ──────────────────────────────────────────────────────────────────
# Single-user app-level login. If unset, the panel is OPEN (dev only).
# Set a strong value in production when internet-exposed.
AUTH_PASSWORD=

# ── TLS profile (only used by:  docker compose --profile tls up -d) ────────
# Real domain pointed at this host and an email for Let's Encrypt registration.
DOMAIN=panel.example.com
ACME_EMAIL=you@example.com
