# ── PolyPanel configuration ───────────────────────────────────────────────
# Copy to .env (never commit .env) and adjust. All values have safe defaults.

# Web server port (Next.js). nginx proxies to this on 127.0.0.1.
PORT=3000

# Where the SQLite file + WAL live. The service user must own this directory.
# Dev default if unset: ./data
DATA_DIR=/var/lib/polypanel

# ── Poller ────────────────────────────────────────────────────────────────
# Seconds between poll cycles. Conservative: 20–30s over ~50 markets is safe.
POLL_INTERVAL=25
# Number of top markets (by 24h volume) to track. Bounds request count.
MARKET_LIMIT=50
# Divergence threshold (absolute prob difference) that raises a DIVERGE flag.
DIVERGE_THRESHOLD=0.05
# Fee/slippage buffer applied to arbitrage detection (per share, in $).
ARB_FEE_BUFFER=0.01

# Restrict discovery to these Polymarket category tag slugs (comma-separated).
# Empty = global (all markets). Setting this is an APPROXIMATE "Polymarket US"
# view — it filters by market TYPE, NOT by verified per-jurisdiction (e.g. New
# York) tradeability. Polymarket's public API exposes no per-state flag.
# Each listed tag is fetched on its own (top markets by 24h volume), so a
# high-volume tag won't crowd out smaller ones. Use specific sports to actually
# see them — "sports" alone is dominated by whatever's biggest right now.
# Examples:
#   politics,sports,business
#   politics,business,soccer,tennis,basketball,baseball,mma,golf,hockey
# Valid sport tags: soccer, tennis, basketball, baseball, football (NFL), mma,
# golf, hockey, cricket. MARKET_LIMIT applies PER tag — lower it (e.g. 15–25)
# if you track many.
MARKET_CATEGORIES=

# Sports markets get a team snapshot (badge, league, recent form, next match)
# via TheSportsDB, cached in SQLite. Uses the free test key by default; override
# with your own key's base URL if you have one. Leave unset for the default.
SPORTSDB_BASE=

# Optional: an API-Football key (free tier at dashboard.api-football.com) adds
# real TOP SCORERS to soccer markets. Cached aggressively to respect the daily
# limit. Leave unset to disable. NEVER commit a real key.
APIFOOTBALL_KEY=

# Live scores on the Matches view come from ESPN's public scoreboards (keyless).
# Override the league list (comma-separated "sport/league" slugs) to add/remove
# competitions. Leave unset for a sensible multi-sport default.
SCORE_LEAGUES=

# ── Auth ──────────────────────────────────────────────────────────────────
# Single-user app-level login. If unset, the panel is OPEN (dev only).
# Set a strong value in production when internet-exposed.
AUTH_PASSWORD=

# Public mode. When PUBLIC=true AND AUTH_PASSWORD is set: anyone can VIEW/scan
# the panel without logging in, but logging/editing/resolving estimates ("My
# Calls") still requires the operator password. Leave unset for a fully-private
# panel (whole site behind the login).
PUBLIC=
